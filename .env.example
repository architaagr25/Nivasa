# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Database (Supabase, Mumbai region)
# Transaction pooler, port 6543 - used by the app at runtime
DATABASE_URL=
# Session pooler, port 5432 - used by migrations and seeding
DIRECT_URL=
# Session pooler URI of the separate test project - used only by automated tests
TEST_DATABASE_URL=

# Supabase client (Realtime and Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
# Any random string of 32+ characters
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI (Google AI Studio key)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Protects the reminder job endpoint
CRON_SECRET=

# true shows simulated OTPs and messages in the in-app outbox
DEMO_MODE=true
